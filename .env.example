# Puerto y host del servidor HTTP
PORT=3000
HOST=0.0.0.0

# Origen permitido para CORS (usar '*' solo en desarrollo)
CORS_ORIGIN=*

# Ruta del archivo SQLite (relativa a la raíz del proyecto)
DB_PATH=./data/parkit.db

# Secreto para firmar los tokens JWT (cambiar en producción)
JWT_SECRET=parkit-dev-secret-cambiar-en-produccion

# Duración de los tokens (ej. 7d, 24h)
JWT_EXPIRES_IN=7d
